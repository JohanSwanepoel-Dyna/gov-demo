   "18": {
    "type": "markdown",
    "content": "## Experience and change"
   },
   "19": {
    "title": "RUM funnel, sessions per step",
    "type": "data",
    "query": "fetch user.events\n| filter dt.rum.application.entity == \"APPLICATION-EA7C4B59F27D43EB\" and characteristics.has_view_summary == true\n| summarize sessions = countDistinct(dt.rum.session.id), by: {view.detected_name}\n| sort sessions desc",
    "visualization": "categoricalBarChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     },
     "coloring": {
      "colorRules": [
       {
        "colorMode": "color-palette",
        "colorPalette": "purple-rain",
        "comparator": "= *value*",
        "field": "DT.name",
        "type": "string",
        "value": ""
