{
 "id": "fff6ca52-9dac-495c-91db-2f02b18cc977",
 "name": "Carer Support Portal demo",
 "type": "dashboard",
 "content": {
  "version": 21,
  "variables": [],
  "tiles": {
   "0": {
    "type": "markdown",
    "content": "# Carer Support Portal (fictional demonstration)\nDepartment of Community Services demo. All policy, amounts and citizens are invented. Run scenarios with `make scenario NAME=...`, see `docs/runbook.md`."
   },
   "1": {
    "title": "Claims submitted",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| filter event.type == \"claim.submitted\"\n| summarize submitted = count()",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "Submitted",
      "recordField": "submitted"
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "2": {
    "title": "Payments posted",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| filter event.type == \"claim.payment_posted\"\n| summarize posted = count()",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "Paid",
      "recordField": "posted"
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "3": {
    "title": "Payments failed",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| filter event.type == \"claim.payment_failed\"\n| summarize failed = count()",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "Failed",
      "recordField": "failed"
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "4": {
    "title": "Average queue wait (ms)",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| filter event.type == \"claim.payment_posted\"\n| summarize wait = avg(queue_wait_ms)",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "Queue wait ms",
      "recordField": "wait"
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "5": {
    "title": "Tokens used",
    "type": "data",
    "query": "timeseries tokens = sum(gen_ai.client.token.usage)\n| fieldsAdd total = arraySum(tokens)\n| fields total",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "Tokens",
      "recordField": "total"
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "6": {
    "title": "Prompts blocked by guardrails",
    "type": "data",
    "query": "fetch spans\n| filter service.name == \"claims-api\" and startsWith(toString(span.name), \"chat \")\n| summarize blocked = countIf(matchesPhrase(toString(gen_ai.response.finish_reasons), \"content_filter\"))",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "Blocked",
      "recordField": "blocked"
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "7": {
    "type": "markdown",
    "content": "## Claims and payments"
   },
   "8": {
    "title": "Claim journey, events by step",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| summarize events = count(), by: {event.type}\n| sort events desc",
    "visualization": "categoricalBarChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     },
     "coloring": {
      "colorRules": [
       {
        "colorMode": "color-palette",
        "colorPalette": "purple-rain",
        "comparator": "= *value*",
        "field": "DT.name",
        "type": "string",
        "value": ""
       }
      ]
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "9": {
    "title": "Claims over time",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| filter in(event.type, \"claim.submitted\", \"claim.payment_posted\", \"claim.payment_failed\")\n| makeTimeseries events = count(), by: {event.type}",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     },
     "coloring": {
      "colorRules": [
       {
        "field": "DT.name",
        "type": "string",
        "comparator": "= *value*",
        "value": "claim.payment_posted",
        "colorMode": "single-color",
        "color": "var(--dt-colors-charts-apdex-good-default, #1c520a)"
       },
       {
        "field": "DT.name",
        "type": "string",
        "comparator": "= *value*",
        "value": "claim.payment_failed",
        "colorMode": "single-color",
        "color": "var(--dt-colors-charts-loglevel-emergency-default, #ae132d)"
       }
      ]
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "10": {
    "title": "Payment queue wait (ms)",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| filter event.type == \"claim.payment_posted\"\n| makeTimeseries average = avg(queue_wait_ms), p95 = percentile(queue_wait_ms, 95)",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "11": {
    "title": "Failed payments by error",
    "type": "data",
    "query": "fetch bizevents\n| filter event.provider == \"dcs.carer-portal\"\n| filter event.type == \"claim.payment_failed\"\n| summarize failed = count(), by: {error}",
    "visualization": "categoricalBarChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     },
     "coloring": {
      "colorRules": [
       {
        "colorMode": "color-palette",
        "colorPalette": "fireplace",
        "comparator": "= *value*",
        "field": "DT.name",
        "type": "string",
        "value": ""
       }
      ]
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "12": {
    "title": "Server response time p95 by service",
    "type": "data",
    "query": "fetch spans\n| filter k8s.namespace.name == \"gov-demo\" and span.kind == \"server\"\n| makeTimeseries p95 = percentile(duration, 95), by: {dt.service.name}",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "13": {
    "type": "markdown",
    "content": "## AI assistant"
   },
   "14": {
    "title": "Tokens by type",
    "type": "data",
    "query": "timeseries tokens = sum(gen_ai.client.token.usage), by: {gen_ai.token.type}",
    "visualization": "areaChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "15": {
    "title": "Chat completion latency",
    "type": "data",
    "query": "fetch spans\n| filter service.name == \"claims-api\" and startsWith(toString(span.name), \"chat \")\n| makeTimeseries p50 = percentile(duration, 50), p95 = percentile(duration, 95)",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "16": {
    "title": "Guardrail outcome per chat",
    "type": "data",
    "query": "fetch spans\n| filter service.name == \"claims-api\" and startsWith(toString(span.name), \"chat \")\n| fieldsAdd outcome = if(matchesPhrase(toString(gen_ai.response.finish_reasons), \"content_filter\"), \"blocked\", else: \"allowed\")\n| summarize chats = count(), by: {outcome}",
    "visualization": "categoricalBarChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
     },
     "coloring": {
      "colorRules": [
       {
        "colorMode": "color-palette",
        "colorPalette": "purple-rain",
        "comparator": "= *value*",
        "field": "DT.name",
        "type": "string",
        "value": ""
       }
      ]
     }
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "17": {
    "title": "Chat errors by type",
    "type": "data",
    "query": "fetch spans\n| filter service.name == \"claims-api\" and startsWith(toString(span.name), \"chat \")\n| filter isNotNull(error.type)\n| summarize failed = count(), by: {error.type}",
    "visualization": "categoricalBarChart",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "chartSettings": {
      "legend": {
       "position": "bottom"
      }
