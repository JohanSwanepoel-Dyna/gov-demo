    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "20": {
    "title": "Deployment events",
    "type": "data",
    "query": "fetch events\n| filter event.type == \"CUSTOM_DEPLOYMENT\"\n| fields timestamp, event.name, event.description\n| sort timestamp desc\n| limit 10",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "table": {}
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   },
   "21": {
    "title": "Problems on the demo services",
    "type": "data",
    "query": "fetch dt.davis.problems\n| filter contains(toString(affected_entity_ids), \"SERVICE-A07B249CEC01B91E\") or contains(toString(affected_entity_ids), \"SERVICE-F5D773513E6C7E59\") or contains(toString(affected_entity_ids), \"SERVICE-B5B342815508E1EE\") or contains(toString(affected_entity_ids), \"SERVICE-197A36756FADC0DA\") or contains(toString(affected_entity_ids), \"SERVICE-4896FBFBEE918D79\")\n| fields timestamp, display_id, event.name, event.status\n| sort timestamp desc\n| limit 10",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "table": {}
    },
    "querySettings": {
     "maxResultRecords": 1000,
     "defaultScanLimitGbytes": 500,
     "maxResultMegaBytes": 100,
     "defaultSamplingRatio": 10,
     "enableSampling": false
    }
   }
