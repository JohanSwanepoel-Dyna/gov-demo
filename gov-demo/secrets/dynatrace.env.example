# Dynatrace tenant settings. Copy to secrets/dynatrace.env (make secrets-init) and fill in.
# The real file is gitignored. Never paste values into chat or commit them.
DT_ENVIRONMENT_URL=https://<environment-id>.live.dynatrace.com

# One API token. Expected scopes, confirm against current docs before creating:
#   bizevents.ingest, events.ingest, logs.ingest, metrics.ingest, openTelemetryTrace.ingest
DT_API_TOKEN=

